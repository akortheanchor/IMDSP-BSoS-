    "type": "function",
    "z": "flow1",
    "name": "Simulate Sensor Data",
    "func": "\nlet dataset = [\n    { time: \"08:00\", HR: 72, SpO2: 98, activity: \"low\" },\n    { time: \"09:00\", HR: 75, SpO2: 97, activity: \"low\" },\n    { time: \"10:00\", HR: 110, SpO2: 94, activity: \"high\" },\n    { time: \"11:00\", HR: 80, SpO2: 96, activity: \"moderate\" },\n    { time: \"12:00\", HR: 70, SpO2: 98, activity: \"low\" }\n];\nlet index = flow.get('index') || 0;\nlet reading = dataset[index];\nflow.set('index', (index + 1) % dataset.length);\n\n// Format for chart: one message per metric\nreturn [\n    { payload: reading.HR, topic: \"Heart Rate\" },\n    { payload: reading.SpO2, topic: \"SpO2\" }\n];\n",
    "outputs": 2,
    "noerr": 0,
    "x": 340,
    "y": 120,
    "wires": [
      [
        "ui_chart"
      ],
      [
        "ui_chart"
      ]
    ]
  },
